{
  "name": "savemyride-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:local-env": "node scripts/generate-local-env.js",
    "backend:local-api": "sam local start-api --env-vars env.json",
    "prebackend:build": "npm --prefix backend install && npm --prefix backend run sync-shared",
    "backend:build": "sam build",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  }
}
